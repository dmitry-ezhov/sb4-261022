<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>labs</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>lab-02-module-map-and-build-solution</artifactId>

  <name>lab-02-module-map-and-build-solution</name>
  <description>
    M02 lab (solution): the same library catalog API as M01, with a build that
    says only what the module uses. No dependency pins a version, no plugin
    pins a version, nothing is declared that the parent already provides, and
    the starters are the Boot 4 names.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <!-- The Jakarta Bean Validation constraints on the request body. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <!-- The webmvc test slice (MockMvc, AutoConfigureMockMvc) is a separate
           starter in Boot 4; spring-boot-starter-test does not include it. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Declared without a version: the parent's plugin management
             supplies both the version and the repackage execution. -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
