<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>labs</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>lab-08-transactions-start</artifactId>

  <name>lab-08-transactions-start</name>
  <description>
    M08 lab (start): the library application exactly as the testing lab left
    it - the suite is right, the accounting is not. The Loan STORE is still
    the compiled CopyOnWriteArrayList the LoanRepository comment has been
    promising to replace since M05, the Copy has no guard to speak of, and
    two borrows of one Copy both succeed. The diagnostics state what must
    change: the Loan feature's calls go to the database, the Copy's guard
    becomes one statement, and the borrow becomes the transaction boundary -
    proved by a test that fails without the lock.
  </description>

  <properties>
    <!--
      Start modules ship fewer tests than their solution counterpart, so the
      coverage floor does not apply here. Every other gate still does.
    -->
    <jacoco.skip>true</jacoco.skip>
    <!-- This module's diagnostics fail by design, so the diagnostics-solutions
         profile skips it. -->
    <diagnostics.skip>true</diagnostics.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <!-- The Jakarta Bean Validation implementation: the constraints on the
           request bodies are read, so the boundary's answers are real ones. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <!-- The declarative HTTP Service client: the @HttpExchange interfaces
           and the proxy that implements them. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <!-- JPA over Hibernate, over the JDBC half it transitively brings:
           the Copy reads are derived from the method name, and the guarded
           update this lab asks for over H2's copy table runs through the
           engine the migration created. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <!-- The module that makes Flyway's migration run under Boot 4's
           auto-configuration. A bare flyway-core configures nothing. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway 12 modularised its database support out of flyway-core:
           without this module, booting against PostgreSQL fails with
           "Unsupported Database: PostgreSQL", while H2 runs. -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- The second engine's driver. The migration still runs as written. -->
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- The lab rig's engine, the application.yml's default. -->
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- The webmvc test slice has its own starter in Boot 4; the suite is
           meant to reach the slice annotations through it. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The shared test fixtures: a deterministic clock. -->
      <groupId>com.example</groupId>
      <artifactId>labs-support</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The availability service, stubbed for the wiring home. -->
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- @Container and @EnabledIfDockerAvailable: the suite's Testcontainers
           reads and the diagnostics' race against the second engine. -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- PostgreSQLContainer 2, at its new coordinates and its new package. -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- @ServiceConnection: the container test hands the application the
           container's address without a line of configuration. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
