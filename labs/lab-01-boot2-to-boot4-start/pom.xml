<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>labs</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>lab-01-boot2-to-boot4-start</artifactId>

  <name>lab-01-boot2-to-boot4-start</name>
  <description>
    M01 lab (start): a library catalog API written the way it would have been
    written for Spring Boot 2. It compiles and its tests pass, but the API does
    not follow Boot 4 conventions yet. The diagnostic tests under
    src/test/java/.../diagnostics/ describe what has to change.
  </description>

  <properties>
    <!--
      Start modules ship fewer tests than their solution counterpart, so the
      coverage floor does not apply here. Every other gate still does: a start
      module must be formatted, lint-clean and bug-free - its defects are the
      ones the lab asks you to fix, not accidental ones.
    -->
    <jacoco.skip>true</jacoco.skip>
    <!-- This module's diagnostics fail by design, so the diagnostics-solutions
         profile skips it. -->
    <diagnostics.skip>true</diagnostics.skip>
  </properties>

  <dependencies>
    <dependency>
      <!-- Boot 4 deprecated spring-boot-starter-web in favour of this name. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <!-- The webmvc test slice (MockMvc, AutoConfigureMockMvc) is a separate
           starter in Boot 4; spring-boot-starter-test does not include it. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
