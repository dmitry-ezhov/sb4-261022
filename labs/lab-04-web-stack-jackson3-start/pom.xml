<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>labs</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>lab-04-web-stack-jackson3-start</artifactId>

  <name>lab-04-web-stack-jackson3-start</name>
  <description>
    M04 lab (start): the library application with the availability service
    declared but not consulted - every copy is assumed to be on the shelf, so
    the library lends copies that are not there and never has to deal with
    what the service says.
  </description>

  <properties>
    <!--
      Start modules ship fewer tests than their solution counterpart, so the
      coverage floor does not apply here. Every other gate still does.
    -->
    <jacoco.skip>true</jacoco.skip>
    <!-- This module's diagnostics fail by design, so the diagnostics-solutions
         profile skips it. -->
    <diagnostics.skip>true</diagnostics.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <!-- The Jakarta Bean Validation constraints on the request body. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <!-- The webmvc test slice has its own starter in Boot 4. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The shared test fixtures: a deterministic clock. -->
      <groupId>com.example</groupId>
      <artifactId>labs-support</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The availability service, stubbed for the diagnostics. -->
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
